# Anime Dub Studio — Environment Configuration
APP_ENV=development
DEBUG=true

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///storage/studio.db
STORAGE_PATH=storage
MODEL_PATH=models

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TRANSLATION_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=gemma4:e2b

# Optional Remote Colab Worker
COLAB_WORKER_URL=

# Hardware Worker Preference: auto, mac, colab
WORKER_PREFERENCE=auto
